#!/usr/bin/env python3
"""Fail a push when the clang-tidy compilation database is missing or stale.

`cpp-linter-hooks` deliberately skips clang-tidy locally when it finds no
compilation database and fails only when `CI` is set, which is the exact inverse
of D-09. This guard owns that failure: it runs first at the pre-push stage and
exits non-zero with the exact command that regenerates the database.

The guard validates; it never repairs. It does not run PlatformIO, it does not
write `.pio/`, and it never writes a file of any kind. Regenerating the database
is a developer action:

  pio run -d tests -e native -t compiledb

Usage:
  python3 scripts/clang-tidy-db [--dir PATH]

Exit codes (the same 0/1/2 vocabulary as `scripts/check_architecture.py`):
  0  the database exists, parses, and is not older than any input it depends on
  1  the database is absent, or older than a configuration input or a source it
     describes
  2  usage or environment error (bad arguments, unusable root, unreadable or
     malformed database)

`file` entries are resolved from the compilation database's own rules, not from
the repository root. A `file` value may be absolute, or relative to that entry's
`directory` field; this database mixes both forms (`lib/common/src/*.c` is
absolute, `.pio/libdeps/native/Unity/src/unity.c` and `src/main.c` are relative
to `<root>/tests`). Resolving a relative entry against the root instead would
report a falsely stale database for every relative entry. An entry whose
resolved path no longer exists is skipped, because only entries that still exist
can be out of date.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

DATABASE = Path("tests") / "compile_commands.json"

# The two configuration inputs that define the native environment. A database
# older than either one was built from a different environment.
CONFIG_INPUTS = (Path("tests") / "platformio.ini", Path("platformio.shared.ini"))

REMEDY = "pio run -d tests -e native -t compiledb"


class EnvironmentProblem(Exception):
    """An unusable root or an unreadable database: exit 2, never a silent pass."""


def resolve_root(directory: str | None) -> Path:
    """Return the root to check, defaulting to the git top level."""
    if directory:
        root = Path(directory)
    else:
        completed = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=False,
        )
        if completed.returncode != 0:
            raise EnvironmentProblem(
                "git rev-parse --show-toplevel failed: "
                f"{(completed.stderr or '').strip() or 'no diagnostic'}"
            )
        root = Path(completed.stdout.strip())
    root = root.resolve()
    if not root.is_dir():
        raise EnvironmentProblem(f"not a directory: {root}")
    return root


def load_entries(database: Path) -> list:
    """Read and shape-check the database; a malformed file is an environment error."""
    try:
        text = database.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        raise EnvironmentProblem(f"cannot read {database}: {exc}") from exc
    try:
        entries = json.loads(text)
    except json.JSONDecodeError as exc:
        raise EnvironmentProblem(f"cannot parse {database}: {exc}") from exc
    if not isinstance(entries, list):
        raise EnvironmentProblem(f"{database}: top level must be a list of entries")
    for entry in entries:
        if not isinstance(entry, dict) or not isinstance(entry.get("file"), str):
            raise EnvironmentProblem(
                f"{database}: every entry must be an object with a string 'file'"
            )
    return entries


def described_paths(entries: list, root: Path) -> list[Path]:
    """Resolve every described source the way the database declares it.

    A relative `file` is relative to that entry's own `directory`, never to the
    repository root. A `directory` that is itself relative is taken from the
    root, and a still-relative result is taken from the root as well.
    """
    resolved: list[Path] = []
    for entry in entries:
        source = Path(entry["file"])
        if not source.is_absolute():
            directory = entry.get("directory")
            base = Path(directory) if isinstance(directory, str) and directory else root
            if not base.is_absolute():
                base = root / base
            source = base / source
        if not source.is_absolute():
            source = root / source
        resolved.append(source)
    return resolved


def stale_inputs(root: Path, database: Path, described: list[Path]) -> list[Path]:
    """Return every existing input newer than the database."""
    database_mtime = database.stat().st_mtime
    candidates = [root / relative for relative in CONFIG_INPUTS]
    candidates.extend(described)
    stale = []
    for candidate in candidates:
        if not candidate.exists():
            continue
        if candidate.stat().st_mtime > database_mtime:
            stale.append(candidate)
    return stale


def run_check(root: Path) -> tuple[int, list[str]]:
    """Return the exit status and the message lines for one root."""
    database = root / DATABASE
    if not database.is_file():
        return 1, [
            f"FAIL clang-tidy-db: {database} is absent.",
            f"  regenerate it with: {REMEDY}",
        ]

    entries = load_entries(database)
    described = described_paths(entries, root)
    try:
        stale = stale_inputs(root, database, described)
    except OSError as exc:
        raise EnvironmentProblem(f"cannot stat {database} or its inputs: {exc}") from exc

    if stale:
        return 1, [
            f"FAIL clang-tidy-db: {database} is older than {len(stale)} input(s):",
            *(f"  {path}" for path in stale),
            f"  regenerate it with: {REMEDY}",
        ]

    return 0, [
        f"PASS clang-tidy-db: {database} is fresher than "
        f"{len(described) + len(CONFIG_INPUTS)} input(s)"
    ]


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        description="Verify the clang-tidy compilation database is present and fresh."
    )
    parser.add_argument(
        "--dir",
        metavar="PATH",
        help="repository root to check (default: git rev-parse --show-toplevel)",
    )
    args = parser.parse_args(argv)

    try:
        root = resolve_root(args.dir)
        status, lines = run_check(root)
    except EnvironmentProblem as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    for line in lines:
        print(line)
    return status


if __name__ == "__main__":
    sys.exit(main())
