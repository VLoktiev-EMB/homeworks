# Ignore only the ambient workspace file VS Code writes when opening the folder.
# A deliberately authored multi-root workspace (relative paths, shared by the team)
# is a legitimate artifact and MUST NOT be caught by a broad *.code-workspace glob.
homeworks.code-workspace

# Agent worktrees (isolated executor checkouts; .claude/CLAUDE.md stays tracked)
.claude/worktrees/

# Video (linked, never committed — D-21)
*.mp4
*.mov
*.avi
*.webm
*.mkv

# Internal research cache (planning artifacts stay tracked)
.planning/research/.cache/
