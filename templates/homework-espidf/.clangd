CompileFlags:
  CompilationDatabase: .
  # Required: esp-clangd 21.1.3 ships no resource headers, and clangd excludes
  # the queried driver's builtin headers by default. Verified: 0 errors on
  # homeworks/<id>/src/main.cpp.
  BuiltinHeaders: QueryDriver
  Remove:
    - -mlongcalls
    - -mtext-section-literals
    - -mdisable-hardware-atomics
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fmacro-prefix-map=*
    - -fzero-init-padding-bits=*
    - -fno-malloc-dce
Diagnostics:
  Suppress:
    - unknown-argument
    - drv_unknown_argument
